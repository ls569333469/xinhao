# 本机统一 Key 配置。复制为 .env 后填写；不要提交或分享 .env。
# 等号后直接粘贴，无需引号；含空格或 # 时推荐双引号。
# 内容为字面值，不执行命令，不展开 ${变量}。
# AI 地址、模型、协议仍由页面“设置 → AI”管理，避免双份配置冲突。
AI_API_KEY=

# Clawby：尚待实测权限及⑤链上净流语义；填写不代表已接入扫描。
CLAWBY_API_KEY=

# 链上数据候选。仅 Santiment 现有历史采集已接入读取。
SANTIMENT_API_KEY=
CRYPTOQUANT_API_KEY=
GLASSNODE_API_KEY=

# 旧版独立检索适配器的可选配置；默认原生联网检索不需要这两项。
RESEARCH_RETRIEVAL_BASE_URL=
RESEARCH_RETRIEVAL_API_KEY=

# Dune：精确充提验证候选；需要有效试用/套餐。填入不代表已接入⑤。
DUNE_API_KEY=
